# Environnement de test : utilisé UNIQUEMENT par docker compose (alias dctest)
# pour démarrer la MongoDB de test. Les tests ne lisent pas ce fichier :
# leur configuration (connexion, JWT, tick, seed) est dans TestApiFactory.cs.


# --- MongoDB ---
# Port de la MongoDB de test sur la machine (docker-compose.test.yml).
# Doit rester égal au port par défaut de TestApiFactory (mongodb://localhost:27018).
MONGO_PORT=27018


# --- Inutilisées en test ---
# Lues par compose dans docker-compose.yml (services server et console, jamais démarrés en test).
# Présentes seulement pour éviter les warnings "variable is not set".
API_PORT=5100
MONGO_USERNAME=unused
MONGO_PASSWORD=unused
MONGO_DATABASE=unused
JWT_SECRET=unused
JWT_EXPIRY_HOURS=1
JWT_REFRESH_TOKEN_DAYS=1
PRICE_TICK_SECONDS=86400
SEED_ADMIN_EMAIL=unused
SEED_ADMIN_PASSWORD=unused
SEED_PLAYER_EMAIL=unused
SEED_PLAYER_PASSWORD=unused