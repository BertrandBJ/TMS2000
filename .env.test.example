# --- API ---
API_PORT=5100
# Port différent du dev pour lancer les deux en même temps, et pour que les tests puissent lire la base directement

# --- MongoDB ---

# Port exposé sur la machine (dev uniquement, via docker-compose.override.yml)

MONGO_PORT=27018
MONGO_USERNAME=tms2000_admin

# Générer avec : openssl rand -hex 24 (hex uniquement, le mot de passe est dans l'URI Mongo)

MONGO_PASSWORD=
MONGO_DATABASE=tms2000_test

# --- JWT ---

# Générer avec : openssl rand -base64 32

JWT_SECRET=
JWT_EXPIRY_HOURS=1

# --- Seed ---

SEED_ADMIN_EMAIL=admin@tms2000.local
SEED_ADMIN_PASSWORD=
SEED_PLAYER_EMAIL=player@tms2000.local
SEED_PLAYER_PASSWORD=

# --- Moteur de prix ---

PRICE_TICK_SECONDS=86400
abusivement long pour pas faire foirer les test.