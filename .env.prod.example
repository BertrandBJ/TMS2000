# Environnement de production : copié en .env.prod sur le serveur de déploiement
# (ubuntu-dev, /home/uha40/Documents/TMS2000). Jamais commité, jamais dans GitLab.

# --- API ---

# Port de l'API sur le serveur (le conteneur écoute sur 8080)

API_PORT=5000

# --- MongoDB ---

# Pas de MONGO_PORT : en prod, MongoDB n'est joignable que par l'API, sur le réseau Docker interne.

MONGO_USERNAME=tms2000_admin

# Générer avec : openssl rand -hex 24 (hexadécimal uniquement : le mot de passe est placé dans l'URI Mongo)

MONGO_PASSWORD=
MONGO_DATABASE=tms2000

# --- JWT ---
# Générer avec : openssl rand -base64 32 (différent de celui de dev)

JWT_SECRET=
JWT_EXPIRY_HOURS=24
JWT_REFRESH_TOKEN_DAYS=7

# --- Seed (premier lancement uniquement, via le profil "seed") ---

SEED_ADMIN_EMAIL=admin@tms2000.local
SEED_ADMIN_PASSWORD=
SEED_PLAYER_EMAIL=player@tms2000.local
SEED_PLAYER_PASSWORD=

# --- Moteur de prix ---

PRICE_TICK_SECONDS=30