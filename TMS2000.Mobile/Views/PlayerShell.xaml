<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TMS2000.Mobile.Views.PlayerShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:TMS2000.Mobile.Views"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent Title="Marché"
                      Route="market"
                      ContentTemplate="{DataTemplate views:MarketPage}" />

        <ShellContent Title="Portefeuille"
                      Route="portfolio"
                      ContentTemplate="{DataTemplate views:PortfolioPage}" />

        <ShellContent Title="Historique"
                      Route="transactions"
                      ContentTemplate="{DataTemplate views:TransactionsPage}" />

        <ShellContent Title="Compte"
                      Route="account"
                      ContentTemplate="{DataTemplate views:AccountPage}" />
    </TabBar>
</Shell>