<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TMS2000.Mobile.Views.AdminShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:TMS2000.Mobile.Views"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent Title="Joueurs"
                      Route="adminusers"
                      ContentTemplate="{DataTemplate views:AdminUsersPage}" />

        <ShellContent Title="Règles"
                      Route="adminrules"
                      ContentTemplate="{DataTemplate views:AdminRulesPage}" />

        <ShellContent Title="Ressources"
                      Route="adminresources"
                      ContentTemplate="{DataTemplate views:AdminResourcesPage}" />

        <ShellContent Title="Compte"
                      Route="account"
                      ContentTemplate="{DataTemplate views:AccountPage}" />
    </TabBar>
</Shell>