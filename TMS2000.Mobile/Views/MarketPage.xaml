<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TMS2000.Mobile.Views.MarketPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:TMS2000.Mobile.ViewModels"
    x:DataType="viewModels:MarketViewModel"
    Title="Marché">

    <Grid RowDefinitions="Auto,Auto,*"
          Padding="16,8">

        <Border Grid.Row="0"
                Padding="12"
                Margin="0,0,0,6"
                Stroke="Gray"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="2">
                <Label Grid.Row="0" Grid.Column="0"
                       Text="Solde"
                       FontSize="16" />
                <Label Grid.Row="0" Grid.Column="1"
                       Text="{Binding Balance, StringFormat='{0:N0} $'}"
                       FontSize="18"
                       FontAttributes="Bold"
                       HorizontalOptions="End"
                       HorizontalTextAlignment="End" />
                <Label Grid.Row="1" Grid.Column="0"
                       Text="Valeur des ressources"
                       FontSize="14"
                       TextColor="Gray" />
                <Label Grid.Row="1" Grid.Column="1"
                       Text="{Binding HoldingsValue, StringFormat='{0:N0} $'}"
                       FontSize="14"
                       TextColor="Gray"
                       HorizontalOptions="End"
                       HorizontalTextAlignment="End" />
            </Grid>
        </Border>

        <Label Grid.Row="1"
               Text="{Binding ErrorMessage}"
               TextColor="Red"
               HorizontalTextAlignment="Center" />

        <RefreshView Grid.Row="2"
                     Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsRefreshing}">

            <CollectionView ItemsSource="{Binding MarketRows}"
                            SelectionMode="Single"
                            SelectionChanged="OnResourceSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:MarketRow">
                        <Border Margin="0,6"
                                Padding="12"
                                Stroke="Gray"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#2A2A2A}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding IsOwned}"
                                             Value="True">
                                    <Setter Property="BackgroundColor"
                                            Value="{AppThemeBinding Light=#DDEEFF, Dark=#1E3A5F}" />
                                    <Setter Property="Stroke" Value="SteelBlue" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid ColumnDefinitions="*,Auto"
                                  RowDefinitions="Auto,Auto,Auto"
                                  RowSpacing="4"
                                  ColumnSpacing="8">
                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding ResourceName}"
                                       FontSize="18"
                                       FontAttributes="Bold" />
                                <Label Grid.Row="0" Grid.Column="1"
                                       Text="{Binding CurrentPrice, StringFormat='{0:N0} $'}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       HorizontalOptions="End"
                                       HorizontalTextAlignment="End" />
                                <Label Grid.Row="1" Grid.Column="0"
                                       Text="{Binding OwnedDescription}"
                                       FontSize="14" />
                                <Label Grid.Row="1" Grid.Column="1"
                                       Text="{Binding PriceModeDescription}"
                                       FontSize="14"
                                       TextColor="Gray"
                                       HorizontalOptions="End"
                                       HorizontalTextAlignment="End" />
                                <Label Grid.Row="2" Grid.ColumnSpan="2"
                                       Text="{Binding RulesDescription}"
                                       IsVisible="{Binding HasRules}"
                                       FontSize="13"
                                       TextColor="DarkOrange" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </RefreshView>
    </Grid>
</ContentPage>
