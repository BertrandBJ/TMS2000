<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="TMS2000.Mobile.Views.TransactionCardView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:TMS2000.Mobile.ViewModels"
    x:DataType="viewModels:TransactionRow">

    <Border Margin="0,3"
            Padding="0"
            Stroke="Gray"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 8">
        <Grid ColumnDefinitions="6,*,Auto"
              RowDefinitions="Auto,Auto"
              ColumnSpacing="8"
              RowSpacing="2">
            <BoxView Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                     Color="{Binding AccentColor}" />

            <Label Grid.Row="0" Grid.Column="1"
                   Margin="0,6,0,0"
                   FontSize="15">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{Binding TypeDescription}" />
                        <Span Text="  " />
                        <Span Text="{Binding ResourceName}" FontAttributes="Bold" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <Label Grid.Row="0" Grid.Column="2"
                   Text="{Binding TradeDescription}"
                   Margin="0,6,10,0"
                   FontSize="15"
                   HorizontalOptions="End" HorizontalTextAlignment="End" />

            <Label Grid.Row="1" Grid.Column="1"
                   Text="{Binding DateDescription}"
                   Margin="0,0,0,6"
                   FontSize="12"
                   TextColor="Gray" />
            <Label Grid.Row="1" Grid.Column="2"
                   Text="{Binding ResultDescription}"
                   Margin="0,0,10,6"
                   TextColor="{Binding AccentColor}"
                   FontSize="13"
                   FontAttributes="Bold"
                   HorizontalOptions="End" HorizontalTextAlignment="End" />
        </Grid>
    </Border>

</ContentView>
